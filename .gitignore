credsets.json
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env
saved_queries/

# Export sidecars written next to a workbook
*.truncated.txt
*.manifest.json

# Tooling / machine-local
.claude/
.pytest_cache/
*.egg-info/
dist/
build/
